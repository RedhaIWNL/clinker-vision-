# Release identifiers. Copy to .env for a deployment, then change together.
PIPELINE_IMAGE=clinker-vision-pipeline:rel-1
MODEL_IMAGE=clinker-vision-model:rel-1
MODEL_BUILD=rel-1
MODEL_CPUS=2
MODEL_MEMORY_LIMIT=2g
WEB_PORT=8080
# TEST-ONLY daylight smoke-test bypass. 0 = production (default).
# 1 = relax template-lost self-test so a day feed flows for stack testing.
# Detections/alerts in mode 1 are MEANINGLESS; unset for any real evaluation.
SMOKE_TEST_RELAX_TEMPLATE=0
