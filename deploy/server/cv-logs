#!/usr/bin/env bash
# Save everything needed to diagnose a problem in ONE file on the Desktop (camera passwords hidden).
source "$(dirname "${BASH_SOURCE[0]}")/cv-common.sh"

step "Saving logs"
out_dir="$HOME/Desktop"; [ -d "$out_dir" ] || out_dir="$HOME"
name="clinker-logs-$(date +%Y%m%d-%H%M)"
tmp="$(mktemp -d)/$name"; mkdir -p "$tmp"
hide() { sed -E 's#(rtsp://)[^/@ ]+@#\1***:***@#g; s#(password[^:]*:).*#\1 ***#I'; }

{ echo "version: $(env_get CV_VERSION)"; echo "git: $(git describe --tags --always 2>/dev/null)"; date
  docker compose ps; } > "$tmp/summary.txt" 2>&1
show_status > "$tmp/status.txt" 2>&1
http_get "http://127.0.0.1:$(web_port)/api/v1/status" > "$tmp/status.json" 2>/dev/null
docker compose logs --no-color --tail=3000 model 2>&1 | hide > "$tmp/model.log"
docker compose logs --no-color --tail=3000 pipeline 2>&1 | hide > "$tmp/pipeline.log"
read_config 2>/dev/null | hide > "$tmp/config.yaml"
[ -f .env ] && cp .env "$tmp/env"
df -h . > "$tmp/disk.txt" 2>&1; free -h >> "$tmp/disk.txt" 2>&1

tar -czf "$out_dir/$name.tar.gz" -C "$(dirname "$tmp")" "$name" && rm -rf "$(dirname "$tmp")"
ok "Saved: $out_dir/$name.tar.gz  (send this file)"
pause_if_icon
