# Copy to .env for a deployment. On the plant server deploy/server/cv-update writes CV_VERSION itself.
# Release label of the ready-made images (e.g. v2026.09.30); unset = "dev" (built locally).
CV_VERSION=
# Only to use images from another registry (default ghcr.io/redhaiwnl/clinker-vision-{pipeline,model}).
#PIPELINE_REPO=ghcr.io/redhaiwnl/clinker-vision-pipeline
#MODEL_REPO=ghcr.io/redhaiwnl/clinker-vision-model
MODEL_CPUS=2
MODEL_MEMORY_LIMIT=2g
WEB_PORT=8080
# TEST-ONLY daylight smoke-test bypass. 0 = production (default).
# 1 = relax template-lost self-test so a day feed flows for stack testing.
# Detections/alerts in mode 1 are MEANINGLESS; unset for any real evaluation.
SMOKE_TEST_RELAX_TEMPLATE=0
